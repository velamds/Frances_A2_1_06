text"}], "selected": 0, "correct": 1}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "<span class=\"italic\">Charlotte est all\u00e9e \u00e0 Londres car elle aime voyager et rencontrer de nouveaux gens.</span>  <br>Effet : (Qu'est-ce qui s'est pass\u00e9 ?)<br> Cause : (Pourquoi ?)", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 2}, {"_data": [{"type": "question", "contents": [{"content": "R\u00e9digez une phrase avec \"<span class=\"italic\">parce que</span>\". <br/>Exemple :<span class=\"italic\"> Nous avons fait de la randonn\u00e9e en montagne <span class=\"strong\">parce qu'</span>il faisait si beau.</span>", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 3}, {"_data": [{"type": "question", "contents": [{"content": "R\u00e9digez une phrase avec \"<span class=\"italic\">\u00e0 cause de</span>\". <br/>Exemple : <span class=\"italic\"><span class=\"strong\">\u00c0 cause de</span> la temp\u00e9rature, ils ne sont pas partis en exp\u00e9dition.</span>", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 4}, {"_data": [{"type": "question", "contents": [{"content": "R\u00e9digez une phrase avec \"<span class=\"italic\">car</span>\". <br/>Exemple : <span class=\"italic\">Elle ne peut pas lire la lettre <span class=\"strong\">car</span> elle ne connait pas le mandarin.</span>", "type": "text"}]}, {"content": "secondary_3", "type":