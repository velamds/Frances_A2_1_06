ontents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}], "type": "RSLT", "template_override": 1, "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "id": 0}]}], "stimuli": [{"_data": [], "type": "welcome", "id": 0, "template_override": 1, "contents": [{}]}, {"_data": [], "id": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "frn4le06ob09re2img02.jpg", "audiosrc": "frn4le06ob09re2aud01", "images": [{"time": "0", "image": "frn4le06ob09re2img02.jpg", "id": 0, "text": ""}, {"time": "100", "image": "frn4le06ob09re2img02.jpg", "id": 1, "text": "<span class=\"strong\">Miguel</span> : Je suis r\u00e9colteur de caoutchouc. Mon travail consiste \u00e0 entailler les arbres dans la for\u00eat tropicale afin d'en extraire le latex. Ma journ\u00e9e commence t\u00f4t. Une fois l'arbre entaill\u00e9, le latex coule librement.  <br>\n<span class=\"strong\">Jean</span> : Comment r\u00e9coltez-vous le latex ?"}, {"time": "14300", "image": "frn4le06ob09re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Miguel</span> : Je fais un petit trou dans l'\u00e9corce de l'arbre. Ensuite, j'attache un petit seau en dessous du trou. Le latex sort du trou et entre dans le seau. J'entaille jusqu'\u00e0 350 arbres par jour. <br>\n<span class=\"strong\">Jean</span> : Est-ce qu'il y a beaucoup de gens qui font le m\u00eame travail ? <br>"}, {"time": "28500", "image": "frn4le06ob09re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Miguel</span> : Non, il n'y a plus beaucoup de r\u00e9colteurs de nos jours. La for\u00eat est en train de dispara\u00eetre.  Mes enfants vont \u00e0 l'\u00e9cole pour acqu\u00e9rir d'autres comp\u00e9tences.<br/><span class=\"strong\">Jean</span> : J'aimerais beaucoup vous voir entailler les arbres. <br>\n<span class=\"strong\">Miguel</span> : J'aime bien parler aux gens pendant que je travaille. <br>\n<span class=\"strong\">Jean</span> : \u00c7a a l'air merveilleux."}]}}], "title": "", "type": "audio", "template_override": 1}]}]}